#!/usr/bin/env bash
# remember <title> <content...> — store a deliberate note in Quiet's memory.
# Stored as a single-message chunk, source="note", speaker=$USER.
set -euo pipefail
QUIET_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PY="$QUIET_DIR/venv/bin/python3"
[ -x "$PY" ] || PY=python3
if [ $# -lt 2 ]; then
  echo "usage: remember <title> <content...>" >&2
  exit 1
fi
TITLE="$1"; shift
BODY="$*"
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TRANSFORMERS_VERBOSITY=error HF_HUB_DISABLE_PROGRESS_BARS=1 TQDM_DISABLE=1
exec "$PY" - "$QUIET_DIR" "$TITLE" "$BODY" << 'PYEOF'
import sys, datetime, getpass, logging
from pathlib import Path
logging.disable(logging.INFO)
quiet_dir, title, body = sys.argv[1], sys.argv[2], sys.argv[3]
sys.path.insert(0, quiet_dir)
import memory
msg = {
    "role": "assistant",
    "name": getpass.getuser().capitalize(),
    "content": f"{title}\n\n{body}",
    "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
}
n = memory.ingest_messages([msg], source="note")
print(f"Remembered: {title} ({n} chunk{'s' if n != 1 else ''})")
PYEOF
