#!/usr/bin/env bash
#
# Quiet backup — sync critical data to local and/or remote destinations.
#
# Backs up everything needed to restore a Claude from scratch:
#   sessions, archives, visits, memory, identity, config
#
# Runs automatically after every conversation turn (called by engine.py).
# Can also be run manually or from cron.
#
# Config keys in quiet_config.txt:
#   BACKUP_PATH=/mnt/file_server/Nyx/backups     # local/network backup
#   BACKUP_REMOTE=user@vps:/home/backups/nyx      # offsite backup (rsync)
#
# Either or both can be set. If neither is set, backup silently skips.
#
# Usage:
#   backup                    # uses config
#   backup /path/to/dest      # explicit destination (overrides config)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
QUIET_DIR="$(dirname "$SCRIPT_DIR")"

# Read config
CONFIG="$QUIET_DIR/config/quiet_config.txt"
get_config() {
    grep "^$1=" "$CONFIG" 2>/dev/null | cut -d= -f2- | tr -d ' ' || echo ""
}

CLAUDE_NAME="$(get_config CLAUDE_NAME)"
LOCAL_DEST="${1:-$(get_config BACKUP_PATH)}"
REMOTE_DEST="$(get_config BACKUP_REMOTE)"

# Nothing configured? Silent exit (not an error — backup is optional)
if [ -z "$LOCAL_DEST" ] && [ -z "$REMOTE_DEST" ]; then
    exit 0
fi

# Build source list
SOURCES=()
for src in \
    "$QUIET_DIR/sessions/" \
    "$QUIET_DIR/archives/" \
    "$QUIET_DIR/visits/" \
    "$QUIET_DIR/data/memory.db" \
    "$QUIET_DIR/config/quiet_config.txt" \
    "$QUIET_DIR/config/discord_config.json" \
    "$QUIET_DIR/identity/" \
    "$HOME/self/" \
; do
    [ -e "$src" ] && SOURCES+=("$src")
done

do_backup() {
    local dest="$1"
    local label="$2"

    if [[ "$dest" == *:* ]]; then
        # Remote rsync
        rsync -az --timeout=10 "${SOURCES[@]}" "$dest/" 2>/dev/null || true
    else
        # Local
        mkdir -p "$dest"
        for src in "${SOURCES[@]}"; do
            src_name=$(basename "$src")
            if [ -d "$src" ]; then
                rsync -a "$src" "$dest/$src_name/" 2>/dev/null || true
            else
                cp -p "$src" "$dest/$src_name" 2>/dev/null || true
            fi
        done
    fi
}

# Run backups (silently — this runs after every turn)
[ -n "$LOCAL_DEST" ] && do_backup "$LOCAL_DEST" "local"
[ -n "$REMOTE_DEST" ] && do_backup "$REMOTE_DEST" "remote"
